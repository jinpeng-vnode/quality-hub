# quality-hub 环境变量配置
# 复制此文件为 .env 后使用：cp .env.example .env

# 后端配置
DATABASE_URL=sqlite:///data/quality_hub.db
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# 前端配置
VITE_API_BASE_URL=http://localhost:8000
FRONTEND_PORT=3000

# 项目管理联动（不配则不启用；令牌由部署时的 Jenkins 凭据注入，不要写在这里）
PM_BASE=
PM_TOKEN=
# 写进需求评论的执行详情链接前缀，如 https://quality-hub.todonot.com
QH_PUBLIC_URL=
# 项目管理 webhook 签名密钥（与项目管理里配置的 webhook secret 一致；不配则 webhook 一律 401）
PM_WEBHOOK_SECRET=
